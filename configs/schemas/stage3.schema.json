{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stage3Config",
  "type": "object",
  "required": ["shelter_capacity_slack", "solver", "solve_granularity", "optimality_gap_tolerance"],
  "properties": {
    "shelter_capacity_slack": {"type": "number", "minimum": 0},
    "solver": {"type": "string", "enum": ["pulp", "ortools"]},
    "solve_granularity": {"type": "string", "enum": ["zone", "agent"]},
    "optimality_gap_tolerance": {"type": "number", "minimum": 0}
  },
  "additionalProperties": false
}
