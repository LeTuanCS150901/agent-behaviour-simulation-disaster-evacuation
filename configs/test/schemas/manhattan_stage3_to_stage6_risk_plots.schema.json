{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Configuration-driven Stage 3-6 risk-plots sidecar",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runtime_contract_version", "runtime_schema", "common_contract", "source_run", "spatial_sources",
    "execution", "derivation", "tables", "visualization", "acceptance", "reporting"
  ],
  "properties": {
    "runtime_contract_version": {"const": "risk_plots_sidecar_v010"},
    "runtime_schema": {"type": "string", "minLength": 1},
    "common_contract": {"$ref": "#/$defs/pathHashSchema"},
    "source_run": {
      "type": "object", "additionalProperties": false,
      "required": [
        "output_root", "expected_resolved_config_sha256", "expected_tree_sha256",
        "config_source_manifest", "config_source_manifest_sha256",
        "active_vehicle_table", "active_vehicle_table_sha256",
        "hazard_table", "hazard_table_sha256", "tripinfo", "tripinfo_sha256",
        "route_choice_table", "route_choice_table_sha256",
        "edge_cell_mapping_table", "edge_cell_mapping_table_sha256"
      ],
      "properties": {
        "output_root": {"type": "string", "minLength": 1},
        "expected_resolved_config_sha256": {"$ref": "#/$defs/sha256"},
        "expected_tree_sha256": {"$ref": "#/$defs/sha256"},
        "config_source_manifest": {"type": "string", "minLength": 1},
        "config_source_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "active_vehicle_table": {"type": "string", "minLength": 1},
        "active_vehicle_table_sha256": {"$ref": "#/$defs/sha256"},
        "hazard_table": {"type": "string", "minLength": 1},
        "hazard_table_sha256": {"$ref": "#/$defs/sha256"},
        "tripinfo": {"type": "string", "minLength": 1},
        "tripinfo_sha256": {"$ref": "#/$defs/sha256"},
        "route_choice_table": {"type": "string", "minLength": 1},
        "route_choice_table_sha256": {"$ref": "#/$defs/sha256"},
        "edge_cell_mapping_table": {"type": "string", "pattern": "\\.parquet$"},
        "edge_cell_mapping_table_sha256": {"$ref": "#/$defs/sha256"},
        "origin_table": {"type": "string", "pattern": "\\.parquet$"},
        "origin_table_sha256": {"$ref": "#/$defs/sha256"},
        "destination_table": {"type": "string", "pattern": "\\.parquet$"},
        "destination_table_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "spatial_sources": {"$ref": "#/$defs/spatialSources"},
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "output_root", "fail_if_output_exists", "transactional_rebuild_existing", "preserve_byte_identical", "result_classification"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "output_root": {"type": "string", "minLength": 1},
        "fail_if_output_exists": {"const": true},
        "transactional_rebuild_existing": {"const": true},
        "preserve_byte_identical": {
          "type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "result_classification": {
          "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true,
          "items": {"enum": ["synthetic", "uncalibrated", "test_only", "not_research_approved", "interacting_fronts_unvalidated"]}
        }
      }
    },
    "derivation": {
      "type": "object", "additionalProperties": false,
      "required": [
        "risk_interval_seconds", "arrival_interval_seconds", "fleet_size", "sampling_seed",
        "sample_size", "sampling_populations", "hazard_time_lookup", "interpolation",
        "internal_edge_prefix", "activity_boundary", "risk_zero_tolerance",
        "numerical_tolerance", "x_axis_anchor", "x_axis_offset_seconds",
        "interval_sensitivity_seconds"
      ],
      "properties": {
        "risk_interval_seconds": {"type": "number", "exclusiveMinimum": 0},
        "arrival_interval_seconds": {"type": "number", "exclusiveMinimum": 0},
        "fleet_size": {"type": "integer", "minimum": 1},
        "sampling_seed": {"type": "integer", "minimum": 0},
        "sample_size": {"type": "integer", "minimum": 1},
        "sampling_populations": {
          "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
          "items": {"enum": ["all_agents", "risk_exposed_agents"]},
          "allOf": [
            {"contains": {"const": "all_agents"}},
            {"contains": {"const": "risk_exposed_agents"}}
          ]
        },
        "hazard_time_lookup": {"const": "previous_snapshot"},
        "interpolation": {"const": "none"},
        "internal_edge_prefix": {"type": "string", "minLength": 1},
        "activity_boundary": {"const": "arrival_timestamp_inclusive_pre_movement"},
        "risk_zero_tolerance": {"type": "number", "minimum": 0},
        "numerical_tolerance": {"type": "number", "exclusiveMinimum": 0},
        "x_axis_anchor": {"enum": ["last_arrival", "simulation_end"]},
        "x_axis_offset_seconds": {"type": "number", "minimum": 0},
        "interval_sensitivity_seconds": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "tables": {
      "type": "object", "additionalProperties": false,
      "required": ["directory", "per_agent", "model", "arrival", "cell_ignition", "driven_trace", "route_edge_activity"],
      "properties": {
        "directory": {"type": "string", "minLength": 1},
        "per_agent": {"type": "string", "pattern": "\\.parquet$"},
        "model": {"type": "string", "pattern": "\\.parquet$"},
        "arrival": {"type": "string", "pattern": "\\.parquet$"},
        "cell_ignition": {"type": "string", "pattern": "\\.parquet$"},
        "driven_trace": {"type": "string", "pattern": "\\.parquet$"},
        "route_edge_activity": {"type": "string", "pattern": "\\.parquet$"},
        "positive_risk_count": {"type": "string", "pattern": "\\.parquet$"}
      }
    },
    "visualization": {
      "type": "object", "additionalProperties": false,
      "required": ["directory", "format", "dpi", "font_family", "grid_color", "grid_alpha", "rendering_metadata", "arrival", "per_agent", "model", "spatial_fire_route_map"],
      "properties": {
        "directory": {"type": "string", "minLength": 1},
        "format": {"const": "png"},
        "dpi": {"type": "integer", "minimum": 1},
        "font_family": {"type": "string", "minLength": 1},
        "grid_color": {"type": "string", "minLength": 1},
        "grid_alpha": {"type": "number", "minimum": 0, "maximum": 1},
        "rendering_metadata": {"$ref": "#/$defs/stringMap"},
        "arrival": {"$ref": "#/$defs/arrivalPlot"},
        "per_agent": {"$ref": "#/$defs/agentPlot"},
        "model": {"$ref": "#/$defs/modelPlot"},
        "positive_risk_vehicle_count": {"$ref": "#/$defs/positiveRiskCountPlot"},
        "spatial_fire_route_map": {"$ref": "#/$defs/spatialMap"}
      }
    },
    "acceptance": {
      "type": "object", "additionalProperties": false,
      "required": [
        "nonzero_agents", "maximum_agent_risk", "positive_model_times", "peak_model_risk",
        "peak_model_time_seconds", "advisory_nonzero_cells", "minimum_nonzero_cells",
        "maximum_nonzero_cells", "one_second_exposed_agents", "ever_hazardous_edge_agents",
        "arrived_agents", "first_arrival_seconds", "last_arrival_seconds",
        "interacting_fronts_snapshot_times_seconds", "spatial_map"
      ],
      "properties": {
        "nonzero_agents": {"type": "integer", "minimum": 0},
        "maximum_agent_risk": {"type": "number", "minimum": 0, "maximum": 1},
        "positive_model_times": {"type": "integer", "minimum": 0},
        "peak_model_risk": {"type": "number", "minimum": 0},
        "peak_model_time_seconds": {"type": "number", "minimum": 0},
        "advisory_nonzero_cells": {"type": "integer", "minimum": 0},
        "minimum_nonzero_cells": {"type": "integer", "minimum": 0},
        "maximum_nonzero_cells": {"type": "integer", "minimum": 0},
        "one_second_exposed_agents": {"type": "integer", "minimum": 0},
        "ever_hazardous_edge_agents": {"type": "integer", "minimum": 0},
        "arrived_agents": {"type": "integer", "minimum": 0},
        "first_arrival_seconds": {"type": "number", "minimum": 0},
        "last_arrival_seconds": {"type": "number", "minimum": 0},
        "interacting_fronts_snapshot_times_seconds": {
          "type": "array", "uniqueItems": true, "items": {"type": "number", "minimum": 0}
        },
        "spatial_map": {"$ref": "#/$defs/spatialAcceptance"}
      }
    },
    "reporting": {
      "type": "object", "additionalProperties": false,
      "required": ["reports_directory", "run_report", "repository_report", "manifest", "checksums", "reproduction_guide", "title"],
      "properties": {
        "reports_directory": {"type": "string", "minLength": 1},
        "run_report": {"type": "string", "pattern": "\\.md$"},
        "repository_report": {"type": "string", "pattern": "\\.md$"},
        "manifest": {"type": "string", "pattern": "\\.json$"},
        "checksums": {"type": "string", "minLength": 1},
        "reproduction_guide": {"type": "string", "pattern": "\\.md$"},
        "title": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pathHashSchema": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "expected_sha256", "schema"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "expected_sha256": {"$ref": "#/$defs/sha256"},
        "schema": {"type": "string", "minLength": 1}
      }
    },
    "stringMap": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
    "spatialSources": {
      "type": "object", "additionalProperties": false,
      "required": [
        "handoff_root", "expected_tree_sha256", "checksums", "checksums_sha256",
        "manifest", "manifest_sha256", "fire_state_table", "fire_state_table_sha256",
        "fire_grid_table", "fire_grid_table_sha256", "network", "network_sha256"
      ],
      "properties": {
        "handoff_root": {"type": "string", "minLength": 1},
        "expected_tree_sha256": {"$ref": "#/$defs/sha256"},
        "checksums": {"type": "string", "minLength": 1},
        "checksums_sha256": {"$ref": "#/$defs/sha256"},
        "manifest": {"type": "string", "minLength": 1},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "fire_state_table": {"type": "string", "pattern": "\\.parquet$"},
        "fire_state_table_sha256": {"$ref": "#/$defs/sha256"},
        "fire_grid_table": {"type": "string", "pattern": "\\.parquet$"},
        "fire_grid_table_sha256": {"$ref": "#/$defs/sha256"},
        "network": {"type": "string", "pattern": "\\.net\\.xml$"},
        "network_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "spatialAcceptance": {
      "type": "object", "additionalProperties": false,
      "required": [
        "total_grid_cells", "burning_cells", "interacting_ignition_cells", "vehicle_traces",
        "distinct_normal_edges", "excluded_internal_observations", "trace_runs",
        "fire_ignition_time_range_seconds", "trace_entry_time_range_seconds",
        "route_presence_time_range_seconds", "route_median_occupancy_time_range_seconds",
        "road_grid_cells", "maximum_distinct_vehicles_per_edge",
        "coordinate_frame", "grid_extent"
      ],
      "properties": {
        "total_grid_cells": {"type": "integer", "minimum": 1},
        "burning_cells": {"type": "integer", "minimum": 1},
        "interacting_ignition_cells": {"type": "integer", "minimum": 0},
        "vehicle_traces": {"type": "integer", "minimum": 1},
        "distinct_normal_edges": {"type": "integer", "minimum": 1},
        "excluded_internal_observations": {"type": "integer", "minimum": 0},
        "trace_runs": {"type": "integer", "minimum": 1},
        "fire_ignition_time_range_seconds": {"$ref": "#/$defs/twoNumbers"},
        "trace_entry_time_range_seconds": {"$ref": "#/$defs/twoNumbers"},
        "route_presence_time_range_seconds": {"$ref": "#/$defs/twoNumbers"},
        "route_median_occupancy_time_range_seconds": {"$ref": "#/$defs/twoNumbers"},
        "road_grid_cells": {"type": "integer", "minimum": 1},
        "maximum_distinct_vehicles_per_edge": {"type": "integer", "minimum": 1},
        "coordinate_frame": {"type": "string", "minLength": 1},
        "grid_extent": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}
      }
    },
    "twoNumbers": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
    "timeColour": {
      "type": "object", "additionalProperties": false,
      "required": ["vmin_seconds", "vmax_seconds", "colormap", "colorbar_label", "lightness_samples", "lightness_tolerance"],
      "properties": {
        "vmin_seconds": {"type": "number"}, "vmax_seconds": {"type": "number"},
        "colormap": {"type": "string", "minLength": 1},
        "colorbar_label": {"type": "string", "minLength": 1},
        "lightness_samples": {"type": "integer", "minimum": 16},
        "lightness_tolerance": {"type": "number", "minimum": 0}
      }
    },
    "roadCells": {
      "type": "object", "additionalProperties": false,
      "required": ["cell_size_m", "fill_color", "alpha", "edge_color", "edge_linewidth", "legend_label"],
      "properties": {
        "cell_size_m": {"type": "number", "exclusiveMinimum": 0},
        "fill_color": {"type": "string", "minLength": 1},
        "alpha": {"$ref": "#/$defs/alpha"},
        "edge_color": {"type": "string", "minLength": 1},
        "edge_linewidth": {"type": "number", "minimum": 0},
        "legend_label": {"type": "string", "minLength": 1}
      }
    },
    "fireCells": {
      "type": "object", "additionalProperties": false,
      "required": ["alpha", "edge_color", "edge_linewidth", "legend_label"],
      "properties": {
        "alpha": {"$ref": "#/$defs/alpha"},
        "edge_color": {"type": "string", "minLength": 1},
        "edge_linewidth": {"type": "number", "minimum": 0},
        "legend_label": {"type": "string", "minLength": 1}
      }
    },
    "routeLines": {
      "type": "object", "additionalProperties": false,
      "required": [
        "overlap_measure", "time_statistic", "width_scale", "minimum_width_points",
        "maximum_width_points", "alpha", "casing_color", "casing_alpha",
        "casing_extra_width_points", "width_legend_values", "width_legend_title", "legend_label"
      ],
      "properties": {
        "overlap_measure": {"const": "distinct_vehicles_per_edge"},
        "time_statistic": {"const": "median_vehicle_presence_time_seconds"},
        "width_scale": {"const": "linear"},
        "minimum_width_points": {"type": "number", "exclusiveMinimum": 0},
        "maximum_width_points": {"type": "number", "exclusiveMinimum": 0},
        "alpha": {"$ref": "#/$defs/alpha"},
        "casing_color": {"type": "string", "minLength": 1},
        "casing_alpha": {"$ref": "#/$defs/alpha"},
        "casing_extra_width_points": {"type": "number", "minimum": 0},
        "width_legend_values": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "width_legend_title": {"type": "string", "minLength": 1},
        "legend_label": {"type": "string", "minLength": 1}
      }
    },
    "spatialMap": {
      "type": "object", "additionalProperties": false,
      "required": [
        "enabled", "filename", "figure_size_inches", "title", "x_label", "y_label",
        "trace_source", "route_rendering", "include_internal_edges", "draw_order",
        "road_cells", "fire_cells", "route_lines",
        "interaction_hatch", "interaction_edge_color", "interaction_linewidth",
        "interaction_legend_label", "time_colour", "axis_equal", "background_color",
        "caption_font_size", "caption_bottom_margin_fraction", "caption"
      ],
      "properties": {
        "enabled": {"const": true},
        "filename": {"type": "string", "pattern": "\\.png$"},
        "figure_size_inches": {"$ref": "#/$defs/twoPositiveNumbers"},
        "title": {"type": "string", "minLength": 1},
        "x_label": {"type": "string", "minLength": 1},
        "y_label": {"type": "string", "minLength": 1},
        "trace_source": {"const": "driven_path"},
        "route_rendering": {"const": "edge_width_lines"},
        "include_internal_edges": {"const": false},
        "draw_order": {
          "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
          "items": {"enum": ["network", "fire", "traces", "interaction_marking"]}
        },
        "road_cells": {"$ref": "#/$defs/roadCells"},
        "fire_cells": {"$ref": "#/$defs/fireCells"},
        "route_lines": {"$ref": "#/$defs/routeLines"},
        "interaction_hatch": {"type": "string", "minLength": 1},
        "interaction_edge_color": {"type": "string", "minLength": 1},
        "interaction_linewidth": {"type": "number", "exclusiveMinimum": 0},
        "interaction_legend_label": {"type": "string", "minLength": 1},
        "time_colour": {"$ref": "#/$defs/timeColour"},
        "axis_equal": {"const": true},
        "background_color": {"type": "string", "minLength": 1},
        "caption_font_size": {"type": "number", "exclusiveMinimum": 0},
        "caption_bottom_margin_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.25},
        "caption": {"type": "string", "minLength": 1},
        "origin_destination_overlay": {"$ref": "#/$defs/originDestinationOverlay"}
      }
    },
    "endpointMarkerStyle": {
      "type": "object", "additionalProperties": false,
      "required": ["marker", "marker_size_points_squared", "face_color", "edge_color", "edge_linewidth", "legend_marker_size_points", "legend_label", "label_template", "label_offset_points"],
      "properties": {
        "marker": {"type": "string", "minLength": 1},
        "marker_size_points_squared": {"type": "number", "exclusiveMinimum": 0},
        "face_color": {"type": "string", "minLength": 1},
        "edge_color": {"type": "string", "minLength": 1},
        "edge_linewidth": {"type": "number", "minimum": 0},
        "legend_marker_size_points": {"type": "number", "exclusiveMinimum": 0},
        "legend_label": {"type": "string", "minLength": 1},
        "label_template": {"type": "string", "minLength": 1},
        "label_offset_points": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}
      }
    },
    "originDestinationOverlay": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "filename", "base_figure_filename", "expected_base_figure_sha256", "title", "coordinate_definition", "origins", "destinations", "zorder_offset", "label_font_size", "label_font_weight", "label_text_color", "label_box_color", "label_box_alpha", "legend_title", "legend_location", "legend_frame_alpha"],
      "properties": {
        "enabled": {"const": true},
        "filename": {"type": "string", "pattern": "\\.png$"},
        "base_figure_filename": {"type": "string", "pattern": "\\.png$"},
        "expected_base_figure_sha256": {"$ref": "#/$defs/sha256"},
        "title": {"type": "string", "minLength": 1},
        "coordinate_definition": {"const": "line_interpolated_midpoint_50_percent_edge_length"},
        "show_labels": {"type": "boolean"},
        "origins": {"$ref": "#/$defs/endpointMarkerStyle"},
        "destinations": {"$ref": "#/$defs/endpointMarkerStyle"},
        "zorder_offset": {"type": "number", "exclusiveMinimum": 0},
        "label_font_size": {"type": "number", "exclusiveMinimum": 0},
        "label_font_weight": {"type": "string", "minLength": 1},
        "label_text_color": {"type": "string", "minLength": 1},
        "label_box_color": {"type": "string", "minLength": 1},
        "label_box_alpha": {"$ref": "#/$defs/alpha"},
        "legend_title": {"type": "string", "minLength": 1},
        "legend_location": {"type": "string", "minLength": 1},
        "legend_frame_alpha": {"$ref": "#/$defs/alpha"}
      }
    },
    "alpha": {"type": "number", "minimum": 0, "maximum": 1},
    "twoPositiveNumbers": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "exclusiveMinimum": 0}},
    "arrivalPlot": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "filename", "figure_size_inches", "title", "x_label", "y_label", "line_width", "line_color", "y_limits", "annotation_template"],
      "properties": {
        "enabled": {"const": true},
        "filename": {"type": "string", "pattern": "\\.png$"},
        "figure_size_inches": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "exclusiveMinimum": 0}},
        "title": {"type": "string", "minLength": 1},
        "x_label": {"type": "string", "minLength": 1},
        "y_label": {"type": "string", "minLength": 1},
        "line_width": {"type": "number", "exclusiveMinimum": 0},
        "line_color": {"type": "string", "minLength": 1},
        "y_limits": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
        "annotation_template": {"type": "string", "minLength": 1}
      }
    },
    "agentPlot": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "filenames", "figure_size_inches", "titles", "x_label", "y_label", "line_width", "color_map", "terminal_marker", "terminal_marker_size", "y_limits", "legend_columns", "annotation_template"],
      "properties": {
        "enabled": {"const": true},
        "filenames": {"type": "object", "additionalProperties": false, "required": ["all_agents", "risk_exposed_agents"], "properties": {
          "all_agents": {"type": "string", "pattern": "\\.png$"},
          "risk_exposed_agents": {"type": "string", "pattern": "\\.png$"}
        }},
        "titles": {"type": "object", "additionalProperties": false, "required": ["all_agents", "risk_exposed_agents"], "properties": {
          "all_agents": {"type": "string", "minLength": 1},
          "risk_exposed_agents": {"type": "string", "minLength": 1}
        }},
        "figure_size_inches": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "exclusiveMinimum": 0}},
        "x_label": {"type": "string", "minLength": 1},
        "y_label": {"type": "string", "minLength": 1},
        "line_width": {"type": "number", "exclusiveMinimum": 0},
        "color_map": {"type": "string", "minLength": 1},
        "terminal_marker": {"type": "string", "minLength": 1},
        "terminal_marker_size": {"type": "number", "exclusiveMinimum": 0},
        "y_limits": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 1}},
        "legend_columns": {"type": "integer", "minimum": 1},
        "annotation_template": {"type": "string", "minLength": 1}
      }
    },
    "modelPlot": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "filename", "figure_size_inches", "title", "x_label", "y_label", "line_width", "line_color", "terminal_marker", "terminal_marker_size", "y_axis_policy", "headroom_fraction", "annotation_template"],
      "properties": {
        "enabled": {"const": true},
        "filename": {"type": "string", "pattern": "\\.png$"},
        "figure_size_inches": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "exclusiveMinimum": 0}},
        "title": {"type": "string", "minLength": 1},
        "x_label": {"type": "string", "minLength": 1},
        "y_label": {"type": "string", "minLength": 1},
        "line_width": {"type": "number", "exclusiveMinimum": 0},
        "line_color": {"type": "string", "minLength": 1},
        "terminal_marker": {"type": "string", "minLength": 1},
        "terminal_marker_size": {"type": "number", "exclusiveMinimum": 0},
        "y_axis_policy": {"const": "zero_to_data_max_with_headroom"},
        "headroom_fraction": {"type": "number", "minimum": 0},
        "annotation_template": {"type": "string", "minLength": 1}
      }
    },
    "positiveRiskCountPlot": {
      "type": "object", "additionalProperties": false,
