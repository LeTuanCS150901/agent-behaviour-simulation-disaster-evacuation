{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ManhattanTestConfig",
  "type": "object",
  "required": ["network_file", "crs_override", "origins", "destinations", "ignition_edges", "vehicle_class"],
  "properties": {
    "network_file": {"type": "string", "minLength": 1},
    "crs_override": {"type": "string", "minLength": 1},
    "origins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["edge_id", "num_cars"],
        "properties": {
          "edge_id": {"type": "string", "minLength": 1},
          "num_cars": {"type": "integer", "exclusiveMinimum": 0}
        },
        "additionalProperties": false
      }
    },
    "destinations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["edge_id", "capacity"],
        "properties": {
          "edge_id": {"type": "string", "minLength": 1},
          "capacity": {"type": "integer", "exclusiveMinimum": 0}
        },
        "additionalProperties": false
      }
    },
    "ignition_edges": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "vehicle_class": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false,
  "_note": "Cross-field constraint 'sum(destinations.capacity) >= sum(origins.num_cars)' cannot be expressed in draft-07 JSON Schema; check in scripts/validate_config.py before running Stage 3."
}
