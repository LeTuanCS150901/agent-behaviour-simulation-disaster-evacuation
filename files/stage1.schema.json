{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stage1Config",
  "type": "object",
  "required": ["total_population", "study_area_bbox_path", "zones_path", "census_data_path", "zone_count_tolerance_pct"],
  "properties": {
    "total_population": {"type": "integer", "exclusiveMinimum": 0},
    "study_area_bbox_path": {"type": "string", "minLength": 1},
    "zones_path": {"type": "string", "minLength": 1},
    "census_data_path": {"type": "string", "minLength": 1},
    "zone_count_tolerance_pct": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
  },
  "additionalProperties": false
}
